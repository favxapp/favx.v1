{
  "name": "favx-app",
  "version": "0.1.0",
  "private": true,
  "description": "FAVX — incremento 1: fundação, login por e-mail OTP e perfil Creator",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "email:preview": "node --experimental-strip-types scripts/preview-auth-emails.ts",
    "verify:library": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55432 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=mock-key npm run build && node scripts/verify-user-library.cjs",
    "verify:content": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55432 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=mock-key npm run build && node scripts/verify-content-management.cjs",
    "verify:community": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55432 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=mock-key npm run build && node scripts/verify-community.cjs",
    "verify:public": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55434 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=mock-key npm run build && node scripts/verify-public-guides.cjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.118",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "ai": "7.0.173",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "standardwebhooks": "1.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "playwright-core": "1.65.1",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
