# Valores públicos por desenho (URL e chave publicável). NUNCA colocar service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Send Email Hook — configurar no servidor antes de ativar no Supabase.
APP_URL=https://favx-v1.vercel.app
RESEND_API_KEY=
SEND_EMAIL_HOOK_SECRET=
RESEND_FROM_EMAIL=noreply@mail.favx.app
EMAIL_SUPPORT_ADDRESS=suporte@favx.app
# Opcional: URL HTTPS pública da logo definitiva (PNG recomendado).
EMAIL_LOGO_URL=
