# Valores públicos por desenho (URL e chave publicável). NUNCA colocar service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Send Email Hook — configurar no servidor antes de ativar no Supabase.
APP_URL=https://favx-v1.vercel.app
RESEND_API_KEY=
SEND_EMAIL_HOOK_SECRET=
RESEND_FROM_EMAIL=noreply@mail.favx.app
EMAIL_SUPPORT_ADDRESS=suporte@favx.app
# Opcional: URL HTTPS pública da logo definitiva (PNG recomendado).
EMAIL_LOGO_URL=

# Foto de perfil: chave de Storage Zone, nunca a API key de Stream nem NEXT_PUBLIC.
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_ZONE=
# Host da região no painel Bunny (hostname ou URL HTTPS raiz, sem caminho da zone).
BUNNY_STORAGE_HOST=
# Origem HTTPS pública da Pull Zone. Seguir configuração por ambiente.
BUNNY_CDN_URL=

# OpenAI editorial assistant (server only). Optional model override.
OPENAI_API_KEY=
OPENAI_EDITOR_MODEL=gpt-6.1-sol

# Private post originals: SEPARATE Storage Zone, never connected to a public Pull Zone.
BUNNY_ORIGINALS_STORAGE_ZONE=
BUNNY_ORIGINALS_STORAGE_HOST=
BUNNY_ORIGINALS_ACCESS_KEY=
